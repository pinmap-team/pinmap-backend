{
  "name": "pinmap-multiuser-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env service/api.mjs",
    "worker": "node --env-file-if-exists=.env service/worker.mjs",
    "start:local": "node --env-file-if-exists=.env service/local.mjs",
    "migrate:legacy": "node --env-file-if-exists=.env service/migrate-legacy.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "ffmpeg-static": "5.3.0",
    "yauzl": "^3.4.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "better-sqlite3@12.11.1": true
  }
}
