# Copy to .env and replace these values. Keep .env out of Git.
MULTIUSER_PORT=8200
MULTIUSER_HOST=127.0.0.1
MULTIUSER_DATA_DIR=.multiuser-data
PINMAP_INVITE_CODE=replace-with-a-long-random-secret
PUBLIC_ORIGIN=http://127.0.0.1:8200
# Local preview only: serve the Pinmap prototype from the same origin as the API.
# PINMAP_FRONTEND_DIR=/absolute/path/to/pinmap-web-latest-20261113
# Public-link collection and place-name lookup reuse the shared Cloud Run
# extractor. The token is the same server-only value used by the Vercel API.
# PINMAP_EXTRACTOR_ORIGIN=https://your-extractor.run.app
# PINMAP_EXTRACTOR_TOKEN=replace-with-server-only-token
MULTIUSER_AI_PROVIDER=ollama
MULTIUSER_MODEL=qwen2.5vl:3b
# Cloud Gemini: set MULTIUSER_AI_PROVIDER=gemini and MULTIUSER_MODEL=gemini-2.5-flash.
# Keep the key only in the server environment, never in browser code or Git.
# GEMINI_API_KEY=your-private-gemini-api-key
# Place photos are requested by this optional service using a server-side key.
# GOOGLE_MAPS_API_KEY=your-server-side-places-api-key
# Local Google basemap: a separate HTTP-referrer-restricted Maps JavaScript API key.
# GOOGLE_MAPS_BROWSER_KEY=your-browser-maps-javascript-key
WORKER_CONCURRENCY=1
MULTIUSER_DAILY_JOB_LIMIT=50
MULTIUSER_MAX_IMAGES=20
# Audio transcription is required for posts with an audio track.
# Local Mac: install whisper-cli and a multilingual ggml model, then set:
# ASR_PROVIDER=whisper_cli
# WHISPER_MODEL_PATH=.models/ggml-base.bin
# WHISPER_CLI_PATH=whisper-cli
# GPU deployment: use a separate vLLM speech-to-text server:
# ASR_PROVIDER=vllm
# ASR_BASE_URL=http://private-asr-host:8001/v1
# ASR_MODEL=openai/whisper-large-v3-turbo
# ASR_API_KEY=replace-with-private-asr-key
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# GPU deployment: MULTIUSER_AI_PROVIDER=vllm, MULTIUSER_MODEL=<vision-model>
# VLLM_BASE_URL=http://private-gpu-host:8000/v1
# VLLM_API_KEY=replace-with-private-model-key
