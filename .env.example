# Vercel API project. Set real values in Vercel environment settings.
PINMAP_EXTRACTOR_ORIGIN=https://your-cloud-run-service.run.app
PINMAP_EXTRACTOR_TOKEN=
PINMAP_TEST_ACCESS_CODE=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Cloud Run extractor. Set independently in Cloud Run environment settings.
PINMAP_TEST_TOKEN=
MULTIUSER_AI_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
# Set to 0 to disable short-lived caching of identical completed AI requests.
PINMAP_AI_CACHE_ENABLED=1
# Cloud Run: bounded classification + ambiguous map validation, using GEMINI_API_KEY.
PINMAP_DECISIONS_ENABLED=1
# Skip OCR/full media analysis only when caption evidence covers the requested items.
PINMAP_CAPTION_FAST_PATH=1

# Server-only Places API key for authenticated saved-place photos.
GOOGLE_MAPS_SERVER_KEY=

# Optional dedicated shared test login. Never put its password in frontend code.
PINMAP_TEST_LOGIN_ENABLED=false
# Existing team test account password; store only in server environment settings.
PINMAP_TEST_LOGIN_PASSWORD=

# Vercel billing API (disabled until migration 005 and Paddle settings are ready).
PADDLE_BILLING_ENABLED=0
PADDLE_ENVIRONMENT=sandbox
PADDLE_MONTHLY_PRICE_ID=pri_01m7z2cr8tnhge9g50z0ddk6fw
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
